#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)

case "$*" in
  "rev-parse --short HEAD")
    revision=$(python3 "$repo_root/scripts/vendor_source.py" revision qwentts)
    printf '%s\n' "${revision:0:7}"
    ;;
  "show -s --format=%cs HEAD")
    printf '%s\n' '2026-08-07'
    ;;
  "describe --match=NeVeRmAtCh --always --abbrev=8")
    revision=$(python3 "$repo_root/scripts/vendor_source.py" revision ggml)
    printf '%s\n' "${revision:0:8}"
    ;;
  "log -1 --format=%ad --date=local")
    printf '%s\n' 'Wed Jul 22 02:28:41 2026'
    ;;
  "log -1 --format=%s")
    printf '%s\n' 'cuda: gate the GET_ROWS row size only for 32-value sub-block types'
    ;;
  *)
    printf 'unsupported vendored source identity query: git %s\n' "$*" >&2
    exit 2
    ;;
esac
